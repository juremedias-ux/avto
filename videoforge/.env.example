# VideoForge AI — environment variables
# Copy to .env.local for local development. Never commit real values.
# None of these use the NEXT_PUBLIC_ prefix: all are read on the server only.

# --- App ---------------------------------------------------------------------
# Public base URL used for OAuth, e-mail, Stripe and Kling callback URLs.
# Local: http://localhost:3000. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
# Also read at BUILD time to add the Supabase origin to the Content-Security-Policy.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) or legacy "anon" key. Used for auth sessions.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy "service_role" key. SECRET — bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Kling AI ------------------------------------------------------------------
# API key from the Kling developer console. Leave empty for demo/staging mode
# (UI works, generation requests are rejected and no credits are charged).
KLING_API_KEY=
# Optional. Default: https://api-singapore.klingai.com (endpoint for servers outside China).
KLING_API_BASE_URL=
# Optional. Webhook secret (whsec_…) from the Kling console (Basic Settings → Webhook).
# When set, callback signatures are required.
KLING_WEBHOOK_SECRET=
# Optional. USD per Kling unit used for cost reporting when Kling does not return
# a cash amount. Default 0.14 (list price in Kling's pricing table). Set to your contract price.
KLING_USD_PER_UNIT=
# Optional. Per-request HTTP timeout in ms (default 30000).
KLING_REQUEST_TIMEOUT_MS=
# Optional. A task still running after this many minutes is failed and refunded (default 30).
KLING_TASK_TIMEOUT_MINUTES=

# --- Limits --------------------------------------------------------------------
# Max generations per user in draft/queued/processing at the same time (1–10, default 2).
MAX_CONCURRENT_GENERATIONS=2

# --- Stripe --------------------------------------------------------------------
# Secret key (sk_test_… / sk_live_…). Leave empty to disable payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price ID (price_…) for the Business subscription.
STRIPE_SUBSCRIPTION_PRICE_ID=

# --- Cron ----------------------------------------------------------------------
# Random string (>= 32 chars). Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
# to /api/cron/poll-jobs. Generate with: openssl rand -base64 32
CRON_SECRET=
