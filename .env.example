# GradimoCamper – primer nastavitev
# Kopiraj v .env.local (lokalno) oziroma vnesi v nastavitve gostovanja.
# Datoteke .env.local NE dodajaj v Git.

# --- Javno (vidno v brskalniku) -------------------------------------------
# Osnovni naslov strani za kanonične povezave, sitemap in predogled deljenja.
# Lokalno ga lahko pustiš praznega (uporabi se http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- Samo strežnik (nikoli s predpono NEXT_PUBLIC_) -------------------------
# Supabase → Project Settings → Data API: Project URL
SUPABASE_URL=https://rplgjmogsajzzfkohxwy.supabase.co
# Supabase → Project Settings → API Keys: Publishable key (sb_publishable_…)
# ali legacy "anon" ključ. Uporablja se samo za prijavo lastnika.
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys: Secret key (sb_secret_…)
# ali legacy "service_role" ključ. SKRIVNOST – obide RLS.
SUPABASE_SECRET_KEY=

# UUID lastniškega računa (Supabase → Authentication → Users → User UID).
ADMIN_USER_ID=

# Neobvezno: ločena skrivnost za psevdonimizacijo IP-naslovov pri omejevanju
# zahtev (vsaj 32 naključnih znakov). Če je prazno, se izpelje iz
# SUPABASE_SECRET_KEY. Ustvariš jo lahko z: openssl rand -base64 32
RATE_LIMIT_SECRET=

# Neobvezno: glava z IP-naslovom obiskovalca. Na Vercelu pusti prazno
# (x-forwarded-for). Na Netlifyju: x-nf-client-connection-ip.
CLIENT_IP_HEADER=

# --- Obvestilo lastniku ob novi prijavi (neobvezno) --------------------------
# Brez teh vrednosti se prijave shranjujejo, obvestilo pa se ne pošlje.
# Gmail: SMTP_USER je naslov Gmail, SMTP_PASSWORD je 16-mestno geslo za
# aplikacije (App password), ne običajno geslo. SKRIVNOST.
NOTIFY_EMAIL_TO=gradimo.camper@gmail.com
SMTP_USER=
SMTP_PASSWORD=
# Neobvezno (privzeto Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# NOTIFY_EMAIL_FROM = SMTP_USER
SMTP_HOST=
SMTP_PORT=
NOTIFY_EMAIL_FROM=

# Indeksiranje v iskalnikih. Pusti "false", dokler stran ni pripravljena
# za javno objavo (podatki upravljavca, kontakt, pravice za slike).
ALLOW_INDEXING=false
